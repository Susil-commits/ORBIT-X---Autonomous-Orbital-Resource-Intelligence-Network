# ORBIT-X Frontend Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and will override these defaults.

# Backend REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Backend WebSocket base URL (no trailing slash)
VITE_WS_URL=ws://localhost:8000
