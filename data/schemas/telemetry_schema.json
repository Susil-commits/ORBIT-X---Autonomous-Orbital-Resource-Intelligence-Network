{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SatelliteTelemetryFrame",
  "type": "object",
  "required": [
    "timestamp_s",
    "satellite_id",
    "bus_voltage_v",
    "solar_current_a",
    "battery_temp_c",
    "payload_temp_c",
    "reaction_wheel_jitter_dps",
    "rf_snr_db"
  ],
  "properties": {
    "timestamp_s": { "type": "number", "minimum": 0 },
    "satellite_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "bus_voltage_v": { "type": "number", "minimum": 20.0, "maximum": 36.0 },
    "solar_current_a": { "type": "number", "minimum": 0.0, "maximum": 20.0 },
    "battery_temp_c": { "type": "number", "minimum": -40.0, "maximum": 85.0 },
    "payload_temp_c": { "type": "number", "minimum": -40.0, "maximum": 85.0 },
    "reaction_wheel_jitter_dps": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
    "rf_snr_db": { "type": "number", "minimum": -10.0, "maximum": 40.0 },
    "anomaly_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "health_status": { "type": "string", "enum": ["NOMINAL", "DEGRADED", "CRITICAL_FAULT"] }
  }
}
