{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionRequestSchema",
  "type": "object",
  "required": [
    "id",
    "target_lat",
    "target_lon",
    "priority",
    "duration_s",
    "deadline_s"
  ],
  "properties": {
    "id": { "type": "string" },
    "target_lat": { "type": "number", "minimum": -90.0, "maximum": 90.0 },
    "target_lon": { "type": "number", "minimum": -180.0, "maximum": 180.0 },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "duration_s": { "type": "number", "minimum": 5.0, "maximum": 600.0 },
    "deadline_s": { "type": "number", "minimum": 0.0 },
    "data_size_gb": { "type": "number", "minimum": 0.1, "maximum": 500.0 },
    "energy_cost_wh": { "type": "number", "minimum": 1.0, "maximum": 500.0 }
  }
}
